# LeadStack local configuration template. Copy to `.env` (gitignored) and fill
# in local-only values. Placeholders only -- never put a real credential here.
#
# Configuration is read by SaaS-OS's secrets provider (infra.secrets):
# ENVIRONMENT=development reads this `.env` file; test/production read the
# process environment. ENVIRONMENT is mandatory -- there is no default.
ENVIRONMENT=development

# Two database roles (SaaS-OS's model):
# - DATABASE_URL: the restricted application role (NOSUPERUSER NOBYPASSRLS).
#   The app and worker refuse to start under a superuser or BYPASSRLS role.
# - MIGRATIONS_DATABASE_URL: the schema-owner role, used only by
#   `leadstack-migrate`.
# APP_DB_USER names the application role that migrations grant privileges to.
APP_DB_USER=leadstack_app
DATABASE_URL=postgresql+psycopg://leadstack_app:CHANGE_ME_APP@localhost:5432/leadstack
MIGRATIONS_DATABASE_URL=postgresql+psycopg://leadstack_owner:CHANGE_ME_OWNER@localhost:5432/leadstack

# Background jobs and rate limiting.
REDIS_URL=redis://localhost:6379/0

# OIDC (SaaS-OS identity, ZITADEL). Needed only for the /auth/* login flow,
# which Phase 1 does not exercise end to end.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
PUBLIC_APP_ORIGIN=http://localhost:8080

# Signing key for public form tokens (>= 32 random characters). Required for
# lead-capture forms; public form endpoints answer 503 without it.
LEADSTACK_FORM_TOKEN_SECRET=
# Signing key for email confirmation/unsubscribe links (>= 32 random
# characters). Email sending and consent links answer 503 without it.
# PUBLIC_APP_ORIGIN (above) must be https:// outside development/test.
LEADSTACK_LINK_SIGNING_SECRET=

# Outbound email (SaaS-OS core.email, SMTP). Messages fail with
# `email_not_configured` when the sender or SMTP host is missing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_DEFAULT_SENDER=

# Optional tuning:
# LEADSTACK_FORM_DAILY_SUBMISSIONS=2000   # per workspace per 24 h
# LEADSTACK_MAX_CONCURRENT_AUTHZ=4        # raise with DB_POOL_SIZE/DB_POOL_MAX_OVERFLOW
