# syntax=docker/dockerfile:1.7
# LeadStack frontend image (Next.js). Built from the repository root:
#
#   docker build -f deploy/Dockerfile.frontend -t leadstack-frontend .
#
# The browser talks to the API on the same origin (the edge proxy routes
# /v1 and /auth to the backend), so the image needs no backend URL.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
# Exactly the committed lock; no install scripts (same as CI).
RUN npm ci --ignore-scripts
COPY frontend ./
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_OUTPUT=standalone
RUN npm run build


FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
# Self-contained server: compiled configuration and only the traced runtime
# dependencies (no TypeScript, no build or test tooling).
COPY --from=build --chown=root:root /app/.next/standalone ./
COPY --from=build --chown=root:root /app/.next/static ./.next/static
# The official image ships an unprivileged `node` user (uid 1000).
USER node
EXPOSE 3000
CMD ["node", "server.js"]
