# Template for deploy/production.env (never committed: see .gitignore).
# Placeholders only. Generate every password and key independently, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Passwords are placed in connection URLs: use URL-safe characters only.

# Image tag to build and run (a release version or a commit id).
LEADSTACK_VERSION=

# Public host name (DNS must point at this server before the first start)
# and the contact address for TLS certificates.
LEADSTACK_DOMAIN=
ACME_EMAIL=

# --- Data stores: choose ONE of the two blocks (decision D14) ---------------
#
# A) Bundled PostgreSQL and Redis containers (start with `--profile bundled`).
#    They speak plaintext on a private Docker network. SaaS-OS requires TLS
#    in production and will refuse them unless you explicitly accept that by
#    uncommenting the two switches below (single host only).
POSTGRES_DB=leadstack
POSTGRES_SUPERUSER_PASSWORD=
OWNER_DB_USER=leadstack_owner
OWNER_DB_PASSWORD=
APP_DB_USER=leadstack_app
APP_DB_PASSWORD=
REDIS_PASSWORD=
# DB_REQUIRE_TLS=false
# REDIS_REQUIRE_TLS=false
#
# B) External TLS data stores (no `--profile bundled`). Create the two
#    database roles yourself (see deploy/postgres/10-roles.sh) and set:
# DATABASE_URL=postgresql+psycopg://<app role>:<password>@<host>:5432/<database>?sslmode=verify-full
# MIGRATIONS_DATABASE_URL=postgresql+psycopg://<owner role>:<password>@<host>:5432/<database>?sslmode=verify-full
# REDIS_URL=rediss://:<password>@<host>:6379/0

# Identity provider (hosted ZITADEL, decision D8).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Leave empty for a public client with PKCE.
OIDC_CLIENT_SECRET=

# Signing keys (>= 32 random characters each, different from each other).
LEADSTACK_FORM_TOKEN_SECRET=
LEADSTACK_LINK_SIGNING_SECRET=

# Outbound email (optional until email is used; messages fail with
# `email_not_configured` without it).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_DEFAULT_SENDER=
